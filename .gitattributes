# Normalize line endings for Unity text assets
*.cs        text eol=lf
*.json      text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf
*.unitypackage text eol=lf
*.meta      text eol=lf
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.anim      text eol=lf
*.controller text eol=lf
*.physicMaterial   text eol=lf
*.physicMaterial2D text eol=lf
*.renderTexture    text eol=lf
*.shader    text eol=lf
*.shadergraph text eol=lf
*.vfx       text eol=lf
*.preset     text eol=lf
*.uxml       text eol=lf
*.uss        text eol=lf
*.md         text eol=lf

# Unity binary assets — never diff or normalize these
*.fbx       binary
*.png       binary
*.jpg       binary
*.tga       binary
*.psd       binary
*.exr       binary
*.hdr       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.ttf       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.a         binary
